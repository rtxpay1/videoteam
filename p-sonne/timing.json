  ],
  [
   17.168,
   19.058,
   "Auch der Mond verschwindet!"
  ],
  [
   19.058,
   20.388,
   "Er leuchtet ja nur,"
  ],
  [
   20.388,
   21.667,
   "weil die Sonne ihn anstrahlt."
  ],
  [
   21.967,
   23.893,
   "Aber jetzt kommt der eigentliche Schock:"
  ],
  [
   24.193,
   27.391,
   "Ohne die Sonne hält nichts mehr die Erde auf ihrer Bahn."
  ],
  [
   27.691,
   30.281,
   "Sie fliegt einfach geradeaus ins All."
  ],
  [
   30.281,
   32.488,
