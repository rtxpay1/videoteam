  [
   0.55,
   1.239,
   "Was wäre,"
  ],
  [
   1.239,
   3.768,
   "wenn die Sonne plötzlich ausgeht?"
  ],
  [
   4.068,
   5.048,
   "Das Verrückte:"
  ],
  [
   5.048,
   7.244,
   "Du würdest es erst mal gar nicht merken."
  ],
  [
   7.544,
   10.371,
   "Denn ihr Licht braucht über acht Minuten bis zu uns."
  ],
  [
   10.671,
   13.865,
   "Acht Minuten lang ist alles ganz normal."
  ],
  [
   13.865,
   14.264,
   "Dann:"
  ],
  [
   14.264,
   14.903,
   "Schwarz."
  ],
  [
   15.418,
   17.168,
