  ],
  [
   48.125,
   49.805,
   "Aber hier ist der Twist:"
  ],
  [
   49.805,
   52.185,
   "Ganz unten im Ozean gibt es Leben,"
  ],
  [
   52.185,
   53.297,
   "das die Sonne gar nicht braucht."
  ],
  [
   53.597,
   57.558,
   "An heißen Quellen am Meeresgrund könnte es noch sehr lange weitergehen."
  ],
  [
   57.858,
   62.354,
   "Zum Glück hat unsere Sonne noch etwa fünf Milliarden Jahre Brennstoff."
