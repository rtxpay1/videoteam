   39.256,
   "Nach einer Woche sind es weltweit rund minus achtzehn Grad."
  ],
  [
   39.556,
   41.549,
   "Nach einem Jahr rund minus siebzig."
  ],
  [
   41.849,
   44.579,
   "Die Meere frieren an der Oberfläche zu."
  ],
  [
   44.579,
   45.769,
