 "phrases": [
  [
   0.55,
   4.26,
   "Ich hänge in zehn Kilometern Höhe an der Flugzeugtür,"
  ],
  [
   4.26,
   6.344,
   "und sie bewegt sich keinen Millimeter!"
  ],
  [
   6.644,
   8.674,
   "Draußen ist die Luft so dünn,"
  ],
  [
   8.674,
   11.553,
   "dass ich nach einer Minute nicht mehr klar denken könnte."
  ],
  [
   12.121,
   14.711,
   "Darum pumpt das Flugzeug Luft hinein,"
  ],
  [
   14.711,
   17.429,
   "wie auf einem Berg mit zweitausend Metern."
  ],
  [
   17.729,
   21.865,
   "Drinnen drückt also viel mehr Luft als draußen."
  ],
  [
   22.165,
   25.105,
   "Auf jeden Quadratmeter Tür presst so viel,"
  ],
  [
   25.105,
   26.314,
   "wie ein ganzer Elefant wiegt."
  ],
  [
   26.614,
   29.274,
   "Und die Tür ist größer als ihr Rahmen,"
  ],
  [
   29.274,
   31.914,
   "sie sitzt wie ein Stöpsel in der Wanne."
  ],
  [
   32.214,
   34.524,
   "Aufgehen kann sie nur nach innen,"
  ],
  [
   34.524,
   35.161,
   "genau gegen diesen Druck."
  ],
  [
   35.601,
   36.581,
   "Abonnier mich,"
  ],
  [
   36.581,
   39.12,
   "denn jetzt ziehe ich mit aller Kraft."
  ],
  [
   39.42,
   42.817,
   "Gegen einen Elefanten pro Quadratmeter hat eine Eule keine Chance."
  ],
  [
   43.263,
   45.978,
   "Erst kurz vor der Landung wird der Unterschied klein."
  ],
  [
   46.42,
   52.417,
   "Zweitausenddreiundzwanzig öffnete ein Passagier in Südkorea so eine Notausgangstür,"
  ],
  [
   52.667,
   54.144,
   "in zweihundert Metern Höhe."
  ],
  [
   54.611,
   57.271,
   "Das ist lebensgefährlich und strafbar,"
  ],
  [
   57.271,
   57.749,
   "er wurde festgenommen."
  ],
  [
   58.049,
   58.889,
   "Mein Urteil:"
  ],
  [
   58.889,
   60.429,
   "null von zehn Punkten,"
  ],
  [
   60.429,
   62.503,
   "die Tür in zehn Kilometern Höhe gewinnt."
  ],
  [
   62.803,
   64.623,
   "Schreib in die Kommentare,"
  ],
  [
   64.623,
   65.818,
   "was ich als Nächstes testen soll!"
  ]
 ],
